{
  "name": "pi-arc-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Opt-in browser automation for existing Arc tabs from Pi",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/*.smoke.mjs",
    "check": "node --check src/bridge.mjs && node --check src/protocol.mjs && node --check companion/service-worker.mjs && node --check companion/popup.mjs"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright-core": "^1.64.0"
  }
}
